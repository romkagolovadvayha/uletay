DB_HOST=127.0.0.1
DB_NAME=uletay
DB_USER=root
DB_PASS=
ADMIN_USER=admin
ADMIN_PASSWORD=uletay2026
# Минимум 32 символа (требование iron-session)
SESSION_SECRET=change-me-in-production-min-32-chars!!
CORS_ORIGIN=*
BASE_PATH=
UPLOAD_DIR=../uploads
# Production (remote-deploy.sh): absolute paths under DEPLOY_PATH
# REPO_ASSETS_DIR=/var/www/uletay/assets
PORT=3000
# Ключ JS API 3.0: в кабинете developer.tech.yandex.ru укажите localhost в «Ограничение по HTTP Referer»
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Last.fm API key: https://www.last.fm/api/account/create
# Set in GitHub Environment production → Secrets as LASTFM_API_KEY
LASTFM_API_KEY=

# headliners:sync-lastfm — metadata daily (listeners, tracks, tags; no images)
# headliners:sync-web-images — one-off / manual cover search via DuckDuckGo
# Production sync runs in GitHub Actions (.github/workflows/sync-lastfm.yml), not on VPS cron.
# Optional proxy for Last.fm from CI (http://user:pass@host:port) — VPS proxies often fail HTTPS CONNECT
LASTFM_PROXY_URL=

# Web Push. Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@uletayapp.ru
# Необязательно: нужен только если в EAS включена enhanced push security.
EXPO_PUSH_ACCESS_TOKEN=
