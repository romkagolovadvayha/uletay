{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uletayapp.ru/api",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "731031f2-dafb-4a0f-902a-770cd600bfb4"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uletayapp.ru/api",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "731031f2-dafb-4a0f-902a-770cd600bfb4"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uletayapp.ru/api",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "731031f2-dafb-4a0f-902a-770cd600bfb4"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      }
    },
    "ios-simulator": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    },
    "ios-live-activity-qa": {
      "extends": "ios-simulator",
      "env": { "ULETAY_LIVE_ACTIVITY_QA": "1" },
      "buildArtifactPaths": ["artifacts/live-activity-qa/*.log"]
    },
    "ios-store-qa": {
      "extends": "ios-simulator",
      "env": {
        "ULETAY_IOS_STORE_QA": "1",
        "ULETAY_WIDGET_QA": "1"
      },
      "buildArtifactPaths": [
        "artifacts/ios-store-qa-results.tar.gz",
        "artifacts/ios-store-qa/**/*.png",
        "artifacts/ios-store-qa/**/*.xml",
        "artifacts/ios-store-qa/**/*.log",
        "artifacts/ios-store-qa/available-devices.json"
      ]
    },
    "rustore": {
      "extends": "production",
      "env": {
        "RUSTORE_BUILD": "1",
        "RUSTORE_PUSH_PROJECT_ID": "aaukrz3gRAr3K29Vvb8WbeTsxn3wccEq"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6837515167",
        "appleTeamId": "GJVRBGFVG5",
        "ascApiKeyPath": "./credentials/apple/app-store-connect.p8",
        "ascApiKeyId": "JZX48RRLU7",
        "ascApiKeyIssuerId": "54422ecf-7ee1-441d-887b-315cbdc5f315"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
