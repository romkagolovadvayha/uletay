
server {
    listen 80;
    listen [::]:80;
    server_name __VK_HEADLINERS_DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://__VK_HEADLINERS_DOMAIN__$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __VK_HEADLINERS_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__VK_HEADLINERS_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__VK_HEADLINERS_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include __DEPLOY_PATH__/deploy/nginx.compression.conf;

    # Only this public showcase may be embedded in VK. Admin keeps DENY.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, follow" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Frame-Options;

    location = / {
        proxy_pass http://127.0.0.1:__CMS_PORT__/vk-headliners;
    }
    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:__CMS_PORT__;
    }
    location = /favicon.ico { access_log off; return 204; }
    location = /robots.txt { return 200 "User-agent: *\nDisallow: /\n"; }
    location / { return 404; }
}
